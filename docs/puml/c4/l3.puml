@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
skinparam linetype polyline
LAYOUT_WITH_LEGEND()

title Диаграмма компонентов (C4 Level 3) - WatchTower Backend

' === External ===
Person(user, "Пользователь", "DevOps/Admin")
System_Ext(target_systems, "Target Resources", "HTTP resources")
System_Ext(notification_apis, "Telegram Bot API", "Notification provider")

System_Boundary(watchtower, "WatchTower System") {
    Container(spa, "Frontend SPA", "React, TS", "Web Dashboard")

    ContainerDb(db, "PostgreSQL", "Relational DB", "Persistent Data")
    ContainerDb(redis, "Redis", "Key-Value Store", "Recent ProbeSummary Cache")

    Container_Boundary(backend, "Backend Application") {

        ' --- Data Access Layer ---
        Component(repository, "Repository Layer", "Go interfaces and adapters", "Абстракция доступа к PostgreSQL, MongoDB и Redis")

        ' --- API Layer ---
        Component(auth_api, "Auth API", "Go/Gin", "REST Controller")
        Component(monitoring_api, "Monitoring API", "Go/Gin", "REST Controller")

        ' --- Domain Services (Business Logic) ---
        Component(auth_service, "Auth Service", "Go", "Logic: Login, JWT")
        Component(monitoring_service, "Monitoring Mgmt Service", "Go", "Logic: CRUD Monitors")
        Component(metric_query_service, "Metric Query Service", "Go", "Logic: Read Stats/History (CQRS Read)")
        Component(maintenance_service, "Maintenance Service", "Go", "Logic: Windows & Schedules")
        Component(contact_service, "Contact Service", "Go", "Logic: Alert Contacts")

        ' --- Background Workers ---
        Boundary(workers, "Background Workers") {
            Component(healthchecker, "Health Checker", "Go routines", "Scheduler and WorkerPool. Writes raw results.")
            Component(analyzer, "Analyzer", "Go routine", "Polls results, evaluates expectations and updates monitor status.")
            Component(notifier, "Notification", "Go workers", "Consumes status changes and schedules deliveries.")
            Component(notification_provider, "Telegram Provider", "Go adapter", "Calls Telegram Bot API.")
        }
    }
}

' === Relationships ===

' Frontend to API
Rel(user, spa, "Uses")
Rel(spa, monitoring_api, "JSON/HTTP(S)")
Rel(spa, auth_api, "JSON/HTTP(S)")

' API to Services
Rel(auth_api, auth_service, "Calls")
Rel(monitoring_api, monitoring_service, "Calls")
Rel(monitoring_api, metric_query_service, "Calls")
Rel(monitoring_api, maintenance_service, "Calls")
Rel(monitoring_api, contact_service, "Calls")

' Services to Repository
Rel(auth_service, repository, "Read/Write")
Rel(monitoring_service, repository, "Read/Write")
Rel(maintenance_service, repository, "Read/Write")
Rel(contact_service, repository, "Read/Write")
Rel(metric_query_service, repository, "Read Only")

' Workers Interactions
Rel(healthchecker, repository, "Writes Results")
Rel(analyzer, repository, "Reads Results / Writes Status")
Rel(analyzer, notifier, "Publishes monitor.status_changed", "Watermill GoChannel")
Rel(notifier, notification_provider, "Uses")
Rel(notifier, repository, "Reads Contact Info")

' Notification Logic
Rel(notification_provider, notification_apis, "Sends notifications", "HTTPS")

' Checking Logic
Rel(healthchecker, target_systems, "Runs availability probes", "HTTP")

' Persistence
Rel(repository, db, "SQL")
Rel(repository, redis, "RESP")

@enduml
