        },
        "body": {
          "mode": "json",
          "formUrlEncoded": [],
          "multipartForm": [],
          "json": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "script": {
          "req": "",
          "res": ""
        },
        "vars": {
          "req": [],
          "res": []
        },
        "assertions": [],
        "tests": "test(\"HTTP 200\", () => expect(res.getStatus()).to.equal(200));\nif (res.getStatus() !== 200) {\n  bru.setNextRequest(null);\n} else {\n\nconst token = res.getBody().access_token;\ntest(\"Получен JWT\", () => expect(token).to.be.a(\"string\").and.not.empty);\nif (typeof token === \"string\" && token.length) bru.setVar(\"token\", token);\nelse bru.setNextRequest(null);\n\n}"
      },
      "settings": {
        "timeout": 5000,
        "followRedirects": false
      }
    },
