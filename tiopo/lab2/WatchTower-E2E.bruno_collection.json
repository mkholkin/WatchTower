        "timeout": 5000,
        "followRedirects": false
      }
    },
    {
      "uid": "5d71fa8c92f04f22a0965",
      "type": "http-request",
      "name": "02 Вход",
      "seq": 2,
      "request": {
        "url": "{{baseUrl}}/auth/login",
        "method": "POST",
        "headers": [
          {
            "uid": "6ce8a7893d03413399fc3",
            "name": "Content-Type",
            "value": "application/json",
            "enabled": true
          }
        ],
        "params": [],
