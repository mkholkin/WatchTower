        "script": {
          "req": "await new Promise(resolve => setTimeout(resolve, 250));",
          "res": ""
        },
        "vars": {
          "req": [],
          "res": []
        },
        "assertions": [],
        "tests": "test(\"HTTP 200\", () => expect(res.getStatus()).to.equal(200));\nif (res.getStatus() !== 200) {\n  bru.setNextRequest(null);\n} else {\n\nconst monitor = res.getBody();\nif (monitor.status === \"up\") {\n  test(\"Статус монитора up\", () => expect(monitor.status).to.equal(\"up\"));\n} else if (Date.now() < Number(bru.getVar(\"probeDeadline\"))) {\n  bru.setNextRequest(\"05 Ожидание статуса up\");\n} else {\n  test(\"Статус up получен за 30 секунд\", () => expect(monitor.status).to.equal(\"up\"));\n  bru.setNextRequest(\"15 Удаление монитора\");\n}\n\n}"
      },
      "settings": {
        "timeout": 5000,
        "followRedirects": false
      }
    },
    {
      "uid": "79715c709808494a9004c",
      "type": "http-request",
      "name": "06 История содержит HTTP 200",
      "seq": 6,
      "request": {
        "url": "{{baseUrl}}/monitors/{{monitorId}}/checks?limit=10",
        "method": "GET",
        "headers": [],
        "params": [
          {
            "uid": "e0ea88aec0424a81a331e",
            "name": "limit",
            "value": "10",
            "type": "query",
            "enabled": true
          }
        ],
        "auth": {
          "mode": "bearer",
          "bearer": {
            "token": "{{token}}"
          }
        },
        "body": {
          "mode": "none",
          "formUrlEncoded": [],
          "multipartForm": []
        },
        "script": {
          "req": "",
          "res": ""
        },
        "vars": {
          "req": [],
          "res": []
        },
        "assertions": [],
        "tests": "test(\"HTTP 200\", () => expect(res.getStatus()).to.equal(200));\nif (res.getStatus() !== 200) {\n  bru.setNextRequest(null);\n} else {\n\nconst checks = res.getBody();\nconst success = Array.isArray(checks) && checks.some(check => check.status === \"up\" && check.status_code === 200);\nif (success) {\n  test(\"Фоновая проверка: up и HTTP 200\", () => expect(success).to.equal(true));\n} else if (Date.now() < Number(bru.getVar(\"probeDeadline\"))) {\n  bru.setNextRequest(\"05 Ожидание статуса up\");\n} else {\n  test(\"Успешная проверка записана за 30 секунд\", () => expect(success).to.equal(true));\n  bru.setNextRequest(\"15 Удаление монитора\");\n}\n\n}"
      },
      "settings": {
        "timeout": 5000,
        "followRedirects": false
      }
    },
