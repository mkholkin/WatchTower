        "url": "{{baseUrl}}/monitors",
        "method": "POST",
        "headers": [
          {
            "uid": "1d64aebb01bf45ec8c6b9",
            "name": "Content-Type",
            "value": "application/json",
            "enabled": true
          }
        ],
        "params": [],
        "auth": {
          "mode": "bearer",
          "bearer": {
            "token": "{{token}}"
          }
        },
        "body": {
          "mode": "json",
          "formUrlEncoded": [],
          "multipartForm": [],
          "json": "{\n  \"label\": \"Bruno probe\",\n  \"endpoint\": \"{{probeUrl}}\",\n  \"probe_interval\": 1,\n  \"alert_contact_ids\": [],\n  \"maintenance_window_ids\": [],\n  \"network_config\": {\n    \"protocol\": \"HTTP\",\n    \"method\": \"GET\",\n    \"headers\": {},\n    \"body\": \"\",\n    \"follow_redirects\": false\n  },\n  \"expectations\": {\n    \"protocol\": \"HTTP\",\n    \"expected_status_codes\": [\n      200\n    ],\n    \"expected_response_time_ms\": 5000\n  }\n}"
        },
        "script": {
          "req": "",
          "res": ""
        },
        "vars": {
          "req": [],
          "res": []
        },
        "assertions": [],
        "tests": "test(\"HTTP 201\", () => expect(res.getStatus()).to.equal(201));\nif (res.getStatus() !== 201) {\n  bru.setNextRequest(null);\n} else {\n\nconst monitor = res.getBody();\ntest(\"Монитор создан с заданным названием\", () => {\n  expect(monitor.id).to.be.a(\"string\").and.not.empty;\n  expect(monitor.label).to.equal(\"Bruno probe\");\n});\nif (typeof monitor.id === \"string\" && monitor.id.length) {\n  bru.setVar(\"monitorId\", monitor.id);\n  bru.setVar(\"probeDeadline\", Date.now() + 30000);\n} else bru.setNextRequest(null);\n\n}"
      },
      "settings": {
        "timeout": 5000,
        "followRedirects": false
      }
    },
    {
      "uid": "a8da8e6d7d4f49dc85f66",
      "type": "http-request",
      "name": "05 Ожидание статуса up",
      "seq": 5,
      "request": {
        "url": "{{baseUrl}}/monitors/{{monitorId}}",
        "method": "GET",
        "headers": [],
        "params": [],
        "auth": {
