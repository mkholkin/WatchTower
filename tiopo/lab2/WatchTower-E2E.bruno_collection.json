        "script": {
          "req": "bru.setVar(\"login\", \"bruno_\" + Date.now() + \"_\" + Math.random().toString(16).slice(2, 10));\n[\"token\", \"monitorId\", \"probeDeadline\"].forEach(key => bru.deleteVar(key));",
          "res": ""
        },
        "vars": {
          "req": [],
          "res": []
        },
        "assertions": [],
        "tests": "test(\"HTTP 201\", () => expect(res.getStatus()).to.equal(201));\nif (res.getStatus() !== 201) {\n  bru.setNextRequest(null);\n}"
      },
