      "targets": [
        {
          "refId": "A",
          "expr": "(lab6_memory_bytes{run=~\"${run:regex}\",profile=~\"${profile:regex}\",variant=~\"${variant:regex}\",repetition=~\"${repetition:regex}\",component=~\"${component:regex}\"} and (time() - timestamp(lab6_memory_bytes{run=~\"${run:regex}\",profile=~\"${profile:regex}\",variant=~\"${variant:regex}\",repetition=~\"${repetition:regex}\",component=~\"${component:regex}\"}) < 5)) / 1048576",
          "legendFormat": "{{profile}} / {{variant}} / r{{repetition}} / {{component}} / {{run}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "lab6-prometheus"
